@model OnlineShop.Models.Product

@{
    ViewData["Title"] = "刪除商品";
}

<h1>刪除商品</h1>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">描述</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">價格</dt>
        <dd class="col-sm-10">@Model.Price</dd>

        <dt class="col-sm-2">庫存</dt>
        <dd class="col-sm-10">@Model.Stock</dd>

        <dt class="col-sm-2">分類</dt>
        <dd class="col-sm-10">@Model.Category?.Name</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="確定刪除" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">取消</a>
    </form>
</div>
